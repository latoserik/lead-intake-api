# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. .env is git-ignored - never commit it.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# When the function runs on Supabase these three are injected automatically by
# the platform. You only need them locally (supabase functions serve --env-file).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key - bypasses RLS, keep secret>
SUPABASE_ANON_KEY=<anon key - safe to expose to clients>

# --- LLM classification (Anthropic) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional. See README for the default.
ANTHROPIC_MODEL=

# --- Urgent-lead notification webhook (Discord / Slack / Make.com) ---------
WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Timeouts in milliseconds. All optional, defaults shown. ---------------
LLM_TIMEOUT_MS=10000
WEBHOOK_TIMEOUT_MS=5000
DB_TIMEOUT_MS=5000
