# Copy to .env and fill in the real values. .env is git-ignored.

# --- Supabase -------------------------------------------------------------
# On Supabase these are set by the platform. You only need them for local runs
# (supabase functions serve --env-file). SUPABASE_ANON_KEY is not used by the
# function itself, only by scripts/smoke-test.sh.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key - bypasses RLS, keep secret>
SUPABASE_ANON_KEY=<anon key - safe to expose to clients>

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Webhook for urgent leads (Discord / Slack / Make.com) -----------------
WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Timeouts in milliseconds. All optional, defaults shown. ---------------
LLM_TIMEOUT_MS=10000
WEBHOOK_TIMEOUT_MS=5000
DB_TIMEOUT_MS=5000
